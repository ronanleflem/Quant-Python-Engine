{
  "data": {
    "dataset_path": "tests/data/ohlcv.csv",
    "symbols": ["EURUSD"],
    "timeframe": "M1",
    "start": "2025-01-01",
    "end": "2025-01-01"
  },
  "profile": {
    "by_hour": true,
    "by_dow": true,
    "by_month": false,
    "measure": "return",
    "ret_horizon": 1,
    "min_samples_bin": 1
  },
  "signal": {
    "method": "topk",
    "topk": 1,
    "dims": ["hour", "dow"],
    "combine": "or"
  },
  "execution": {
    "slippage_bps": 0.0,
    "commission_bps": 0.0
  },
  "risk": {
    "max_positions": 1,
    "max_allocation": 1.0
  },
  "tp_sl": {
    "stop_loss": 1.0,
    "take_profit": 1.0
  },
  "validation": {
    "min_trades": 0,
    "train_months": 0,
    "test_months": 1,
    "folds": 1,
    "embargo_days": 0
  },
  "artifacts": {
    "out_dir": "runs/seasonality_returns_topk"
  },
  "persistence": {
    "enabled": false
  }
}
