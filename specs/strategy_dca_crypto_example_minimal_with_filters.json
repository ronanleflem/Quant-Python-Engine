{
  "strategy": {
    "strategy_id": "DCA_CRYPTO_DEMO_FILTERS",
    "type": "dca_equity",
    "filters": [
      { "type": "ema_structure", "params": { "ema_fast": 20, "ema_slow": 50, "ema_long": 200 } },
      { "type": "macd_entry", "params": { "fast": 12, "slow": 26, "signal": 9, "direction": "bullish" } },
      { "type": "fractal_analysis", "params": { "window": 64, "min_h": 0.4, "max_h": 0.6 } },
      { "type": "contradictory_signals", "params": { "max_conflicts": 0 } }
    ],
    "params": {
      "asset_class": "CRYPTO",
      "execution_mode": "bar_close",
      "drawdown_reference": "6M",
      "grid": [
        {"dd": -20.0, "weight": 0.20},
        {"dd": -30.0, "weight": 0.20},
        {"dd": -40.0, "weight": 0.20},
        {"dd": -50.0, "weight": 0.20},
        {"dd": -60.0, "weight": 0.20}
      ],
      "tp_sl": {
        "enabled": true,
        "mode": "per_grid_max_dd",
        "sl_dd": -70.0,
        "rules": [
          {"max_dd_reached": -20.0, "tp_pct": 30.0},
          {"max_dd_reached": -30.0, "tp_pct": 30.0},
          {"max_dd_reached": -40.0, "tp_pct": 30.0},
          {"max_dd_reached": -50.0, "tp_pct": 30.0, "be_pct": 15.0},
          {"max_dd_reached": -60.0, "tp_pct": 30.0, "be_pct": 15.0}
        ]
      }
    }
  },
  "data": {
    "start": "2024-01-01",
    "end": "2025-01-01",
    "timeframe": "1D",
    "delta_min_coverage": 0.95,
    "delta_exchange": "BINANCE",
    "delta_base": "s3://quant-delta-dev",
    "delta_prefix": "delta",
    "delta_quotes": "USDT,USDC",
    "schema": "marketdata",
    "table": "crypto_ohlcv",
    "mysql_env": "QE_MARKETDATA_MYSQL_URL"
  },
  "universe": [
    {"symbol": "BTC", "asset_class": "CRYPTO"},
    {"symbol": "ETH", "asset_class": "CRYPTO"},
    {"symbol": "SOL", "asset_class": "CRYPTO"},
    {"symbol": "BNB", "asset_class": "CRYPTO"},
    {"symbol": "XRP", "asset_class": "CRYPTO"},
    {"symbol": "ADA", "asset_class": "CRYPTO"},
    {"symbol": "AVAX", "asset_class": "CRYPTO"},
    {"symbol": "DOGE", "asset_class": "CRYPTO"},
    {"symbol": "LINK", "asset_class": "CRYPTO"}
  ],
  "performance": {
    "initial_capital": 10000,
    "capital_per_unit": 100
  },
  "output": {
    "path": "runs/dca_crypto_backtest_with_filters.json",
    "format": "json"
  }
}
