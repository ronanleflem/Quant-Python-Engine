{
  "strategy": {
    "strategy_id": "DCA_EQUITY_DEMO_FILTERS",
    "type": "dca_equity",
    "filters": [
      { "type": "ema_structure", "params": { "ema_fast": 20, "ema_slow": 50, "ema_long": 200 } },
      { "type": "rsi_entry", "params": { "window": 14, "threshold": 35, "direction": "below" } },
      { "type": "macd_entry", "params": { "fast": 12, "slow": 26, "signal": 9, "direction": "bullish" } },
      { "type": "mean_reversion", "params": { "window": 20, "bb_mult": 2.0, "keltner_mult": 1.5, "direction": "long" } }
    ],
    "params": {
      "asset_class": "EQUITY",
      "execution_mode": "bar_close",
      "drawdown_reference": "3M",
      "grid": [
        {"dd": -20.0, "weight": 0.20},
        {"dd": -30.0, "weight": 0.20},
        {"dd": -40.0, "weight": 0.20},
        {"dd": -50.0, "weight": 0.20},
        {"dd": -60.0, "weight": 0.20}
      ],
      "tp_sl": {
        "enabled": true,
        "mode": "per_grid_max_dd",
        "sl_dd": -70.0,
        "rules": [
          {"max_dd_reached": -20.0, "tp_pct": 20.0, "be_pct": 10.0},
          {"max_dd_reached": -30.0, "tp_pct": 20.0, "be_pct": 10.0},
          {"max_dd_reached": -40.0, "tp_pct": 20.0, "be_pct": 10.0},
          {"max_dd_reached": -50.0, "tp_pct": 20.0, "be_pct": 10.0},
          {"max_dd_reached": -60.0, "tp_pct": 20.0, "be_pct": 10.0},
          {"max_dd_reached": -70.0, "tp_pct": 0.0, "be_pct": 10.0}
        ]
      }
    }
  },
  "data": {
    "start": "2025-01-01",
    "end": "2025-12-01",
    "timeframe": "1D",
    "delta_min_coverage": 0.95,
    "delta_exchange": "NASDAQ",
    "delta_base": "s3://quant-delta-dev",
    "delta_prefix": "delta",
    "schema": "marketdata",
    "table": "ohlcv",
    "mysql_env": "QE_MARKETDATA_MYSQL_URL"
  },
  "universe": [
    {"symbol": "AAPL", "name": "Apple Inc.", "asset_class": "STOCK", "exchange": "NASDAQ", "currency": "USD", "broker": "IBKR"},
    {"symbol": "MSFT", "name": "Microsoft Corp.", "asset_class": "STOCK", "exchange": "NASDAQ", "currency": "USD", "broker": "IBKR"}
  ],
  "performance": {
    "initial_capital": 10000,
    "capital_per_unit": 100
  },
  "output": {
    "path": "runs/dca_equity_backtest_with_filters.json",
    "format": "json"
  }
}
