{
  "strategy": {
    "strategy_id": "BT_EURUSD_M1_EMA_FILTERS",
    "asset_class": "FX"
  },
  "data": {
    "symbols": [
      "EURUSD"
    ],
    "timeframe": "1h",
    "start": "2023-01-01",
    "end": "2023-06-01",
    "delta_base": "s3://quant-delta-dev",
    "delta_prefix": "delta",
    "delta_exchange": "",
    "delta_calendar": "FX",
    "delta_market_type": "SPOT",
    "delta_quotes": "USD,USDT",
    "delta_table": "EURUSD",
    "delta_broker": "DUKASCOPY",
    "delta_min_coverage": 0.9,
    "mysql_env": "QE_MARKETDATA_MYSQL_URL",
    "schema": "marketdata",
    "table": "ohlcv",
    "symbol_col": "symbol",
    "ts_col": "ts",
    "open_col": "open",
    "high_col": "high",
    "low_col": "low",
    "close_col": "close",
    "volume_col": "volume",
    "timeframe_col": "timeframe"
  },
  "signal": {
    "type": "ema_cross",
    "params": {
      "fast": 5,
      "slow": 20,
      "require_crossing": false
    }
  },
  "filters": [
    {
      "type": "ema_structure",
      "params": {
        "ema_fast": 20,
        "ema_slow": 50,
        "ema_long": 200
      }
    },
    {
      "type": "rsi_entry",
      "params": {
        "window": 14,
        "threshold": 35,
        "direction": "below"
      }
    },
    {
      "type": "macd_entry",
      "params": {
        "fast": 12,
        "slow": 26,
        "signal": 9,
        "direction": "bullish"
      }
    },
    {
      "type": "mean_reversion",
      "params": {
        "window": 20,
        "bb_mult": 2.0,
        "keltner_mult": 1.5,
        "direction": "long"
      }
    },
    {
      "type": "fractal_analysis",
      "params": {
        "window": 64,
        "min_h": 0.4,
        "max_h": 0.6
      }
    }
  ],
  "tpsl": {
    "atr_window": 14,
    "atr_k": 1.0,
    "r_mult": 2.0,
    "slippage_bps": 0.0,
    "fee_bps": 0.0
  },
  "performance": {
    "initial_capital": 10000
  },
  "persistence": {
    "enabled": true
  },
  "output": {
    "path": "runs/backtest_eurusd_m1_delta_mysql_with_filters.json",
    "format": "json"
  }
}