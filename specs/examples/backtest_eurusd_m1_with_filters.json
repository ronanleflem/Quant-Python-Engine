{
  "strategy": {
    "strategy_id": "BT_EURUSD_M1_EMA_FILTERS",
    "asset_class": "FX"
  },
  "data": {
    "dataset_path": "specs/examples/data/eurusd_m1_sample.json",
    "symbols": ["EURUSD"],
    "timeframe": "1m",
    "start": "2024-01-01",
    "end": "2024-01-01"
  },
  "signal": {
    "type": "ema_cross",
    "params": { "fast": 5, "slow": 20 }
  },
  "filters": [
    { "type": "ema_structure", "params": { "ema_fast": 20, "ema_slow": 50, "ema_long": 200 } },
    { "type": "rsi_entry", "params": { "window": 14, "threshold": 35, "direction": "below" } },
    { "type": "macd_entry", "params": { "fast": 12, "slow": 26, "signal": 9, "direction": "bullish" } },
    { "type": "mean_reversion", "params": { "window": 20, "bb_mult": 2.0, "keltner_mult": 1.5, "direction": "long" } },
    { "type": "fractal_analysis", "params": { "window": 64, "min_h": 0.4, "max_h": 0.6 } }
  ],
  "tpsl": {
    "atr_window": 14,
    "atr_k": 1.0,
    "r_mult": 2.0,
    "slippage_bps": 0.0,
    "fee_bps": 0.0
  },
  "performance": {
    "initial_capital": 10000
  },
  "persistence": {
    "enabled": false
  },
  "output": {
    "path": "runs/backtest_eurusd_m1_with_filters.json",
    "format": "json"
  }
}
